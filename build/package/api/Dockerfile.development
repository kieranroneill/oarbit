FROM golang:1.26-alpine

# install the required dependencies
RUN apk update \
    && apk add --no-cache git
RUN go install github.com/githubnemo/CompileDaemon@latest

WORKDIR /app

# copy mod files to know which dependencies are needed
COPY ./go.mod .
COPY ./go.sum .

# download and verify dependencies
RUN go mod download
RUN go mod verify

# copy source files
COPY ./cmd .
COPY ./internal .
COPY ./VERSION .

# copy scripts
COPY ./scripts/utilities/_set_vars.sh /_set_vars.sh
COPY ./build/package/api/entrypoint-dev.sh /entrypoint-dev.sh
RUN chmod +x /_set_vars.sh /entrypoint-dev.sh

ENTRYPOINT ["/entrypoint-dev.sh"]
